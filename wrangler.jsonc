{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "industrialpedia",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "industrialpedia.com.mx", "custom_domain": true },
    { "pattern": "www.industrialpedia.com.mx", "custom_domain": true }
  ]
}
