[Unit]
Description=Industrialpedia crawler-server (Deno)
After=network.target

[Service]
Type=simple
User=crawler
WorkingDirectory=/opt/industrialpedia/crawler-server
EnvironmentFile=/opt/industrialpedia/crawler-server/.env
Environment=DENO_DIR=/opt/industrialpedia/.deno-cache
ExecStart=/usr/local/bin/deno run --node-modules-dir=none --allow-net --allow-env --allow-read --allow-write=/opt/industrialpedia/.deno-cache main.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
