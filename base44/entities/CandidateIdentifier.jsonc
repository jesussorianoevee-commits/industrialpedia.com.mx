{
  "name": "CandidateIdentifier",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "crawl_document_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "candidate_text": {
      "type": "string"
    },
    "format_sig": {
      "type": "string"
    },
    "page": {
      "type": "integer"
    },
    "line_index": {
      "type": "integer"
    },
    "label": {
      "type": "string"
    },
    "label_type": {
      "type": "string",
      "enum": [
        "positive",
        "negative",
        "none"
      ],
      "default": "none"
    },
    "in_title": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "candidate_text"
  ]
}