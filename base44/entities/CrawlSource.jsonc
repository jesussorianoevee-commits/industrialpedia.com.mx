{
  "name": "CrawlSource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "subdomains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allow_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deny_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_content_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_depth": {
      "type": "integer"
    },
    "max_pages": {
      "type": "integer"
    },
    "max_documents": {
      "type": "integer"
    },
    "concurrency": {
      "type": "integer"
    },
    "rate_limit_ms": {
      "type": "integer"
    },
    "frequency": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "discovered",
        "pending_review",
        "approved",
        "queued",
        "crawling",
        "downloaded",
        "ingested",
        "paused",
        "rejected",
        "blocked",
        "completed"
      ],
      "default": "pending_review"
    },
    "authorized_by": {
      "type": "string"
    },
    "authorized_date": {
      "type": "string",
      "format": "date-time"
    },
    "robots_allowed": {
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "domain"
  ]
}